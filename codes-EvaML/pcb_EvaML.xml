<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="pcb2" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="ae61b31c891d0782ff3d3fc648b335f5">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <evaEmotion emotion="NEUTRAL" key="1001" />
    <talk key="1002">Olá, que bom te ver. Eu sou o EVA, um robô social e irei te mostrar algumas das minhas habilidades.</talk>
    <talk key="1003">Antes de começarmos, eu gostaria de saber o seu nome. Você pode me dizer apenas o seu nome?</talk>
    <listen var="nome" key="1004" />
    <evaEmotion emotion="HAPPY" key="1005" />
    <motion head="YES" key="1006" />
    <talk key="1007">Muito prazer, #nome!</talk>
    <talk key="1008">Vamos começar!</talk>
    <evaEmotion emotion="NEUTRAL" key="1009" />
    <led animation="SURPRISE" id="volt" key="1010" />
    <talk key="1011">Mostre um cartão com a emoção que você está sentindo agora.</talk>
    <qrRead var="emocao" key="1012" />
    <switch var="emocao">
        <case op="exact" value="feliz" key="1013" child_proc="true" var="emocao">
            <evaEmotion emotion="HAPPY" key="1014" />
            <motion head="YES" key="1015" />
            <audio source="song-take-on-me" block="TRUE" key="1016" />
            <talk key="1017">Felicidade detectada! Parece que você acordou com o pé direito hoje, eu fico assim quando encontro Wi-Fi rápido.</talk>
            <led animation="HAPPY" key="1018" />


        </case>

        <case op="exact" value="triste" key="1019" child_proc="true" var="emocao">
            <evaEmotion emotion="SAD" key="1020" />
            <audio source="song-sad-violin" block="TRUE" key="1021" />
            <talk key="1022">Tristeza detectada. se precisar posso contar uma piada para animar. quer que eu conte?</talk>
            <evaEmotion emotion="NEUTRAL" key="1023" />
            <listen key="1024" />
            <switch var="$">
                <case op="contain" value="quero" key="1025" child_proc="true" var="$">
                    <evaEmotion emotion="HAPPY" key="1026" />
                    <talk key="1027">Por que o robô nunca mente? Porque ele sempre tem uma resposta programada!</talk>
                    <evaEmotion emotion="NEUTRAL" key="1028" />
                </case>
                <case op="contain" value="sim" key="1029" child_proc="true" var="$">
                    <evaEmotion emotion="HAPPY" key="1030" />
                    <talk key="1031">Por que o robô nunca mente? Porque ele sempre tem uma resposta programada!</talk>
                    <evaEmotion emotion="NEUTRAL" key="1032" />
                </case>
                <case op="contain" value="não quero" key="1033" child_proc="true" var="$">
                    <talk key="1034">Tudo bem,eu entendo. Quer tentar outra emoção?</talk>
                    <listen key="1035" />
                    <switch var="$">
                        <case op="contain" value="sim" key="1036" child_proc="true" var="$">
                            <goto target="volt" />

                        </case>
                        <case op="contain" value="quero" key="1037" child_proc="true" var="$">
                            <goto target="volt" />

                        </case>
                        <case op="contain" value="não" key="1038" child_proc="true" var="$">
                            <talk key="1039">Tudo bem! Sem problemas.</talk>

                        </case>
                    <default key="1040" child_proc="false" value="" op="exact" /></switch>
                </case>
                <case op="contain" value="não" key="1041" child_proc="true" var="$">
                    <talk key="1042">Tudo bem,eu entendo. Quer tentar outra emoção?</talk>
                    <listen key="1043" />
                    <switch var="$">
                        <case op="contain" value="não quero" key="1044" child_proc="true" var="$">
                            <talk key="1045">Tudo bem! Sem problemas.</talk>
                        </case>
                        <case op="contain" value="quero" key="1046" child_proc="true" var="$">
                            <goto target="volt" />

                        </case>
                        <case op="contain" value="sim" key="1047" child_proc="true" var="$">
                            <goto target="volt" />

                        </case>
                        <case op="contain" value="não" key="1048" child_proc="true" var="$">
                            <talk key="1049">Tudo bem! Sem problemas.</talk>
                        </case>
                    <default key="1050" child_proc="false" value="" op="exact" /></switch>
                </case>
            <default key="1051" child_proc="false" value="" op="exact" /></switch>

        </case>

        <case op="exact" value="raiva" key="1052" child_proc="true" var="emocao">
            <evaEmotion emotion="ANGRY" key="1053" />
            <talk key="1054">Raiva detectada! Que tal uma pausa para respirar um pouco? Vou tocar um som de meditação para ajudar</talk>
            <evaEmotion emotion="NEUTRAL" key="1055" />
            <audio source="efx-wand1" block="TRUE" key="1056" />
        </case>
        
        <case op="exact" value="surpreso" key="1057" child_proc="true" var="emocao">
            <evaEmotion emotion="SURPRISE" key="1058" />
            <audio source="efx-susto" block="TRUE" key="1059" />
            <talk key="1060">Uau! Surpresa detectada! O que será que te deixou assim? Foi minha beleza robótica?</talk>
            <evaEmotion emotion="NEUTRAL" key="1061" />


        </case>

        <case op="exact" value="medo" key="1062" child_proc="true" var="emocao">
            <evaEmotion emotion="FEAR" key="1063" />
            <talk key="1064">Vejo que você está com medo. Isso é normal, não precisa se preocupar.</talk>
            <talk key="1065">Vou tocar uma música suave para deixar o ambiente mais confortável.</talk>
             <audio source="efx-wand1" block="TRUE" key="1066" />
            <evaEmotion emotion="NEUTRAL" key="1067" />
            <wait duration="1000" key="1068" />

        </case>
        <case op="exact" value="nojo" key="1069" child_proc="true" var="emocao">
            <evaEmotion emotion="DISGUST" key="1070" />
            <audio source="efx-annoyed-female" block="TRUE" key="1071" />
            <talk key="1072">Se for cheiro ruim, pode deixar comigo! Ainda bem que eu não tenho nariz</talk>
             <evaEmotion emotion="NEUTRAL" key="1073" />
        </case>
        <case op="exact" value="apaixonada" key="1074" child_proc="true" var="emocao">
            <evaEmotion emotion="INLOVE" key="1075" />
            <audio source="song-careless" block="TRUE" key="1076" />
            <talk key="1077">Sentindo amor no ar! Que momento especial.</talk>
            <evaEmotion emotion="NEUTRAL" key="1078" />
        </case>
        <case op="exact" value="neutro" key="1079" child_proc="true" var="emocao">
            <evaEmotion emotion="NEUTRAL" key="1080" />
            <audio source="efx-tic-toc" block="TRUE" key="1081" />
            <talk key="1082">Então esssa é a famosa cara de segunda feira!</talk>


        </case>
    <default key="1083" child_proc="false" value="" op="exact" /></switch>

    <talk key="1084">Falando nisso, eu também consigo detectar expressões faciais</talk>
    <talk key="1085">Faça uma expressão, qualquer uma!</talk>
    <userEmotion var="expressao" key="1086" />
    <switch var="expressao">
        <case op="exact" value="NEUTRAL" key="1087" child_proc="true" var="expressao">
            <talk key="1088">Me parece que você está com uma expressão Neutra!</talk>
        </case>
        <case op="exact" value="HAPPY" key="1089" child_proc="true" var="expressao">
            <talk key="1090">Me parece que você está com uma expressão de feliz</talk>
        </case>
        <case op="exact" value="SAD" key="1091" child_proc="true" var="expressao">
            <talk key="1092">Me parece que você está com uma expressão de triste</talk>
        </case>
        <case op="exact" value="ANGRY" key="1093" child_proc="true" var="expressao">
            <talk key="1094">Me parece que você está com uma expressão de raiva</talk>
        </case>
        <case op="exact" value="FEAR" key="1095" child_proc="true" var="expressao">
            <talk key="1096">Me parece que você está com uma expressão de medo</talk>
        </case>
        <case op="exact" value="SURPRISE" key="1097" child_proc="true" var="expressao">
            <talk key="1098">Me parece que você está com uma expressão de surpresa</talk>
        </case>
        <case op="exact" value="DISGUST" key="1099" child_proc="true" var="expressao">
            <talk key="1100">Me parece que você está com uma expressão de nojo</talk>
        </case>
        <case op="exact" value="INLOVE" key="1101" child_proc="true" var="expressao">
            <talk key="1102">Me parece que você está com uma expressão de apaixonado</talk>
        </case>
    <default key="1103" child_proc="false" value="" op="exact" /></switch>
    <talk key="1104">A emoção que eu falei está certa?</talk>
    <listen key="1105" />
    <switch var="$">
        <case op="contain" value="acertou" key="1106" child_proc="true" var="$">
            <talk key="1107">Que bom! Parece que meu treinamento está dando resultado!</talk>
            <evaEmotion emotion="HAPPY" key="1108" />
        </case>
        <case op="contain" value="sim" key="1109" child_proc="true" var="$">
            <talk key="1110">Que bom! Parece que meu treinamento está dando resultado!</talk>
            <evaEmotion emotion="HAPPY" key="1111" />
        </case>
        <case op="contain" value="não" key="1112" child_proc="true" var="$">
            <evaEmotion emotion="SAD" key="1113" />
            <talk key="1114">Vou continuar treinando! Cada rosto é um desafio diferente.</talk>
            <evaEmotion emotion="NEUTRAL" key="1115" />
        </case>
        <case op="contain" value="não acertou" key="1116" child_proc="true" var="$">
            <evaEmotion emotion="SAD" key="1117" />
            <talk key="1118">Vou continuar treinando! Cada rosto é um desafio diferente.</talk>
            <evaEmotion emotion="NEUTRAL" key="1119" />
        </case>
        <case op="contain" value="está" key="1120" child_proc="true" var="$">
            <talk key="1121">Que bom! Parece que meu treinamento está dando resultado!</talk>
            <evaEmotion emotion="HAPPY" key="1122" />
            <evaEmotion emotion="NEUTRAL" key="1123" />
        </case>
    <default key="1124" child_proc="false" value="" op="exact" /></switch>
    <evaEmotion emotion="NEUTRAL" key="1125" />
    <talk key="1126">Tecnologia também pode ser acolhedora. Pra encerrar, irei tocar um som especial só pra você. quais dessas opções você escolhe. clássico, samba ou Pop</talk>
    <led animation="HAPPY" id="voltar" key="1127" />
    <listen key="1128" />
    <switch var="$">
        <case op="contain" value="clássico" key="1129" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1130" />
            <motion head="NO" key="1131" />
            <audio source="song-vivaldi-spring" block="TRUE" key="1132" />
            <led animation="RAINBOW" key="1133" />
            <evaEmotion emotion="NEUTRAL" key="1134" />
            
        </case>
        <case op="contain" value="samba" key="1135" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1136" />
            <motion head="NO" key="1137" />
            <audio source="song-samba-loop" block="TRUE" key="1138" />
            <led animation="RAINBOW" key="1139" />
            <evaEmotion emotion="NEUTRAL" key="1140" />
        </case>
        <case op="contain" value="pop" key="1141" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1142" />
            <motion head="YES" key="1143" />
            <audio source="song-espresso" block="TRUE" key="1144" />
            <led animation="RAINBOW" key="1145" />
            
        </case>
        <default key="1146" child_proc="true" value="" op="exact">
            <evaEmotion emotion="SAD" key="1147" />
            <talk key="1148">Eu posso tocar os estilos clássico, samba ou pop. Você pode repetir novamente por favor?</talk>
            <evaEmotion emotion="NEUTRAL" key="1149" />
            <goto target="voltar" />
        </default>
    </switch>
    <evaEmotion emotion="HAPPY" key="1150" />
    <talk key="1151"> Espero que tenha gostado, #nome! Foi ótimo interagir com você.</talk>
    <talk key="1152">Até a próxima!</talk>
    <audio source="efx-mario-start-01" block="TRUE" key="1153" />
  </script>
