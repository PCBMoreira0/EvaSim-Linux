<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="pcb2" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="ae61b31c891d0782ff3d3fc648b335f5">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <evaEmotion emotion="NEUTRAL" key="1001" />
    <talk key="1002">Olá, que bom te ver. Eu sou o EVA, um robô social. Posso te mostrar algumas das minhas capacidades?</talk>
    <listen key="1003" />
    <switch var="$">
        <case op="contain" value="pode" key="1004" child_proc="true" var="$">
            <talk key="1005">Ótimo!</talk>
        </case>
        <case op="contain" value="sim" key="1006" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1007" />
            <talk key="1008">Ótimo!</talk>

        </case>
        <default key="1009" child_proc="true" value="" op="exact">
            <talk key="1010">tudo bem até a próxima!</talk>
            <stop />
        </default>

    </switch>
    <evaEmotion emotion="NEUTRAL" key="1011" />
    <talk key="1012">Antes de começarmos, posso saber seu nome?</talk>
    <listen var="nome" key="1013" />
    <evaEmotion emotion="HAPPY" key="1014" />
    <motion head="YES" key="1015" />
    <talk key="1016">Muito prazer, #nome!</talk>
    <talk key="1017">Vamos começar!</talk>
    <evaEmotion emotion="NEUTRAL" key="1018" />
    <led animation="SURPRISE" id="volt" key="1019" />
    <talk key="1020">Mostre um cartão com a emoção que você está sentindo agora.</talk>
    <qrRead var="emocao" key="1021" />
    <switch var="emocao">
        <case op="exact" value="feliz" key="1022" child_proc="true" var="emocao">
            <evaEmotion emotion="HAPPY" key="1023" />
            <motion head="YES" key="1024" />
            <audio source="song-take-on-me" block="TRUE" key="1025" />
            <talk key="1026">felicidade detectada! Parece que você acordou com o pé direito hoje, eu fico assim quando encontro Wi-Fi rápido.</talk>
            <led animation="HAPPY" key="1027" />


        </case>

        <case op="exact" value="triste" key="1028" child_proc="true" var="emocao">
            <evaEmotion emotion="SAD" key="1029" />
            <audio source="song-sad-violin" block="TRUE" key="1030" />
            <talk key="1031">tristeza detectada. se precisar posso contar uma piada para animar. Quer?</talk>
            <evaEmotion emotion="NEUTRAL" key="1032" />
            <listen key="1033" />
            <switch var="$">
                <case op="contain" value="sim" key="1034" child_proc="true" var="$">
                    <evaEmotion emotion="HAPPY" key="1035" />
                    <talk key="1036">Por que o robô nunca mente? Porque ele sempre tem uma resposta programada!</talk>
                    <evaEmotion emotion="NEUTRAL" key="1037" />
                </case>
                <case op="contain" value="não" key="1038" child_proc="true" var="$">
                    <talk key="1039">tudo bem,eu entendo. Quer tentar outra emoção?</talk>
                    <listen key="1040" />
                    <switch var="$">
                        <case op="contain" value="sim" key="1041" child_proc="true" var="$">
                            <goto target="volt" />

                        </case>
                        <case op="contain" value="não" key="1042" child_proc="false" var="$">


                        </case>
                    <default key="1043" child_proc="false" value="" op="exact" /></switch>
                </case>
            <default key="1044" child_proc="false" value="" op="exact" /></switch>

        </case>

        <case op="exact" value="raiva" key="1045" child_proc="true" var="emocao">
            <evaEmotion emotion="ANGRY" key="1046" />
            <talk key="1047">Raiva detectada! Que tal uma pausa para respirar um pouco? Vou tocar um som de meditação para ajudar</talk>
            <evaEmotion emotion="NEUTRAL" key="1048" />
            <audio source="efx-wand1" block="TRUE" key="1049" />
        </case>
        
        <case op="exact" value="surpreso" key="1050" child_proc="true" var="emocao">
            <evaEmotion emotion="SURPRISE" key="1051" />
            <audio source="efx-susto" block="TRUE" key="1052" />
            <talk key="1053">Uau! Surpresa detectada! O que será que te deixou assim? Foi minha beleza robótica?</talk>
            <evaEmotion emotion="NEUTRAL" key="1054" />


        </case>

        <case op="exact" value="medo" key="1055" child_proc="true" var="emocao">
            <evaEmotion emotion="FEAR" key="1056" />
            <talk key="1057">Vejo que você está com medo. Isso é normal, não precisa se preocupar.</talk>
            <talk key="1058">Vou tocar uma música suave para deixar o ambiente mais confortável.</talk>
             <audio source="efx-wand1" block="TRUE" key="1059" />
            <evaEmotion emotion="NEUTRAL" key="1060" />
            <wait duration="1000" key="1061" />

        </case>
        <case op="exact" value="nojo" key="1062" child_proc="true" var="emocao">
            <evaEmotion emotion="DISGUST" key="1063" />
            <audio source="efx-annoyed-female" block="TRUE" key="1064" />
            <talk key="1065">Se for cheiro ruim, pode deixar comigo! Ainda bem que eu não tenho nariz</talk>
             <evaEmotion emotion="NEUTRAL" key="1066" />
        </case>
        <case op="exact" value="apaixonada" key="1067" child_proc="true" var="emocao">
            <evaEmotion emotion="INLOVE" key="1068" />
            <audio source="song-careless" block="TRUE" key="1069" />
            <talk key="1070">Estou sentindo amor no ar! Estou gostando muito de interagir com você!</talk>
            <evaEmotion emotion="NEUTRAL" key="1071" />
        </case>
        <case op="exact" value="neutro" key="1072" child_proc="true" var="emocao">
            <evaEmotion emotion="NEUTRAL" key="1073" />
            <audio source="efx-tic-toc" block="TRUE" key="1074" />
            <talk key="1075">então esssa é a famosa cara de segunda feira!</talk>


        </case>
    <default key="1076" child_proc="false" value="" op="exact" /></switch>

    <talk key="1077">Eu também consigo detectar expressões faciais</talk>
    <talk key="1078">Faça uma expressão, qualquer uma!</talk>
    <userEmotion var="expressao" key="1079" />
    <switch var="expressao">
        <case op="exact" value="NEUTRAL" key="1080" child_proc="true" var="expressao">
            <talk key="1081">me parece que você está com uma expressão Neutra!</talk>
        </case>
        <case op="exact" value="HAPPY" key="1082" child_proc="true" var="expressao">
            <talk key="1083">Que legal, me parece que você está com uma expressão de felicidade!</talk>
        </case>
        <case op="exact" value="SAD" key="1084" child_proc="true" var="expressao">
            <talk key="1085">me parece que você está com uma expressão de triste</talk>
        </case>
        <case op="exact" value="ANGRY" key="1086" child_proc="true" var="expressao">
            <talk key="1087">me parece que você está com uma expressão de raiva</talk>
        </case>
        <case op="exact" value="FEAR" key="1088" child_proc="true" var="expressao">
            <talk key="1089">me parece que você está com uma expressão de medo</talk>
        </case>
        <case op="exact" value="SURPRISE" key="1090" child_proc="true" var="expressao">
            <talk key="1091">me parece que você está com uma expressão de surpresa</talk>
        </case>
        <case op="exact" value="DISGUST" key="1092" child_proc="true" var="expressao">
            <talk key="1093">me parece que você está com uma expressão de nojo</talk>
        </case>
        <case op="exact" value="INLOVE" key="1094" child_proc="true" var="expressao">
            <talk key="1095">me parece que você está com uma expressão de apaixonado</talk>
        </case>
    <default key="1096" child_proc="false" value="" op="exact" /></switch>
    <talk key="1097">Eu acertei a sua expressão facial?</talk>
    <listen key="1098" />
    <switch var="$">
        <case op="contain" value="acertou" key="1099" child_proc="true" var="$">
            <talk key="1100">que bom! Parece que meu treinamento está dando resultado!</talk>
            <evaEmotion emotion="HAPPY" key="1101" />
        </case>
        <case op="contain" value="sim" key="1102" child_proc="true" var="$">
            <talk key="1103">que bom! Parece que meu treinamento está dando resultado!</talk>
            <evaEmotion emotion="HAPPY" key="1104" />
        </case>
        <case op="contain" value="não" key="1105" child_proc="true" var="$">
            <evaEmotion emotion="SAD" key="1106" />
            <talk key="1107">Vou continuar treinando! Cada rosto é um desafio diferente.</talk>
            <evaEmotion emotion="NEUTRAL" key="1108" />
        </case>
    <default key="1109" child_proc="false" value="" op="exact" /></switch>
    <evaEmotion emotion="NEUTRAL" key="1110" />
    <talk key="1111">Tecnologia também pode ser acolhedora. Pra encerrar, posso tocar um som especial só pra você. Algum estilo preferido? samba, bóssa nova ou clássico?</talk>
    <led animation="HAPPY" id="voltar" key="1112" />
    <listen key="1113" />
    <switch var="$">
        <case op="contain" value="clássico" key="1114" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1115" />
            <motion head="NO" key="1116" />
            <audio source="song-vivaldi-spring" block="TRUE" key="1117" />
            <led animation="RAINBOW" key="1118" />
            <evaEmotion emotion="NEUTRAL" key="1119" />
            
        </case>
        <case op="contain" value="samba" key="1120" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1121" />
            <motion head="NO" key="1122" />
            <audio source="song-samba-loop" block="TRUE" key="1123" />
            <led animation="RAINBOW" key="1124" />
            <evaEmotion emotion="NEUTRAL" key="1125" />
        </case>
        <case op="contain" value="bossa nova" key="1126" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1127" />
            <motion head="YES" key="1128" />
            <audio source="song-the-girl-from-ipanema" block="TRUE" key="1129" />
            <led animation="RAINBOW" key="1130" />
            
        </case>
        <default key="1131" child_proc="true" value="" op="exact">
            <evaEmotion emotion="SAD" key="1132" />
            <talk key="1133">Desculpe não entendi, pode repetir novamente por favor</talk>
            <evaEmotion emotion="NEUTRAL" key="1134" />
            <goto target="voltar" />
        </default>
    </switch>
    <evaEmotion emotion="HAPPY" key="1135" />
    <talk key="1136">#nome! Espero que tenha gostado! Foi ótimo interagir com você.</talk>
    <talk key="1137">Até a próxima!</talk>
    <audio source="efx-mario-start-01" block="TRUE" key="1138" />
  </script>
