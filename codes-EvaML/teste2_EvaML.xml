<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="teste2" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="38851536d87701d2191990e24a7f8d4e">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <talk key="1001">Olaa meu nome é Eva, vamos jogar um jogo de charada?</talk>
    <talk key="1002">apresente o cartão da sua resposta.</talk>
    <qrRead var="resposta" key="1003" />
    <switch var="resposta">
      <case op="exact" value="não" key="1004" child_proc="true" var="resposta">
        <talk key="1005">foi legal conhecer você,até a próxima!</talk>
      </case>
      <case op="exact" value="sim" key="1006" child_proc="true" var="resposta">
        <evaEmotion emotion="HAPPY" key="1007" />
        <talk key="1008">Que bom que vamos jogar juntos!</talk>
      </case>
    <default key="1009" child_proc="false" value="" op="exact" /></switch>
    <light state="ON" color="WHITE" id="volta" key="1010" />
    <evaEmotion emotion="NEUTRAL" key="1011" />
    <talk key="1012">Quero ver se você conhece bem os equipamentos da casa da descoberta.</talk>
    <talk key="1013">eu vou fazer uma charada e você irá apresentar o cartão que você acha que é a resposta.</talk>
    <audio source="efx-mario-start-01" block="TRUE" key="1014" />
    <counter var="ITERATION_VAR1" op="=" value="1" key="1015" /><switch id="LOOP_ID1_ITERATION_VAR1" var="ITERATION_VAR1"><case op="lte" value="7" key="1016" child_proc="true" var="ITERATION_VAR1"><random min="1" max="8" key="1017" />
      <switch var="$">
        <case op="eq" value="1" key="1018" child_proc="true" var="$">
          <talk key="1019">o que é? o que é? Utilizamos para fechar o circuito elétrico na pilha humana</talk>
      <qrRead var="resposta1" key="1020" />
      <switch var="resposta1">
        <case op="exact" value="pilhahumana" key="1021" child_proc="true" var="resposta1">
          <evaEmotion emotion="HAPPY" key="1022" />
          <audio source="efx-blin2" block="TRUE" key="1023" />
          <light state="ON" color="GREEN" key="1024" />
          <talk key="1025">Muito bem,com suas mãos você conseguiu fechar o circuito.</talk>
          <evaEmotion emotion="NEUTRAL" key="1026" />
          <light state="OFF" key="1027" />
        </case>
        <default key="1028" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1029" />
          <audio source="efx-error" block="TRUE" key="1030" />
          <light state="ON" color="RED" key="1031" />
          <evaEmotion emotion="NEUTRAL" key="1032" />
          <talk key="1033">Pôxa,você precisa voltar para o experimento da pilha humana.</talk>
          <light state="OFF" key="1034" />
        </default>
      </switch>
    </case>
        <case op="eq" value="2" key="1035" child_proc="true" var="$">
          <talk key="1036">o que é? o que é? neste experimento,quando soltamos duas bolas,outras duas são levantadas.</talk>
      <qrRead var="resposta2" key="1037" />
      <switch var="resposta2">
        <case op="exact" value="pendulo" key="1038" child_proc="true" var="resposta2">
          <evaEmotion emotion="HAPPY" key="1039" />
          <audio source="efx-blin2" block="TRUE" key="1040" />
          <light state="ON" color="GREEN" key="1041" />
          <talk key="1042">Parabéns!Newton está orgulhoso de você.</talk> 
          <evaEmotion emotion="NEUTRAL" key="1043" />
          <light state="OFF" key="1044" />              
        </case>
        <default key="1045" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1046" />
          <audio source="efx-error" block="TRUE" key="1047" />
          <light state="ON" color="RED" key="1048" />
          <evaEmotion emotion="NEUTRAL" key="1049" />
          <talk key="1050">Você deveria testar o experimento do pêndulo de newton mais uma vez</talk>
          <light state="OFF" key="1051" />
        </default>
      </switch>

    </case>
        <case op="eq" value="3" key="1052" child_proc="true" var="$">
          <talk key="1053">o que é?o que é?, Quando dizem que estou subindo,na verdade estou descendo.</talk>
      <qrRead var="resposta3" key="1054" />
      <switch var="resposta3">
        <case op="exact" value="duplocone" key="1055" child_proc="true" var="resposta3">
          <evaEmotion emotion="HAPPY" key="1056" />
          <audio source="efx-blin2" block="TRUE" key="1057" />
          <light state="ON" color="GREEN" key="1058" />
          <talk key="1059">UAU!você é muito observador.</talk>
          <evaEmotion emotion="NEUTRAL" key="1060" />
          <light state="OFF" key="1061" />
        </case>
        <default key="1062" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1063" />
          <audio source="efx-error" block="TRUE" key="1064" />
          <light state="ON" color="RED" key="1065" />
          <evaEmotion emotion="NEUTRAL" key="1066" />
          <talk key="1067">Você não entendeu o experimento do duplo cone.</talk>
          <light state="OFF" key="1068" />
        </default>
      </switch>

    </case>
        <case op="eq" value="4" key="1069" child_proc="true" var="$">
          <talk key="1070">o que é? o que é? O anel de alumínio flutua devido ao campo magnético gerado no equipamento.</talk>
      <qrRead var="resposta4" key="1071" />
      <switch var="resposta4">
        <case op="exact" value="anelthompson" key="1072" child_proc="true" var="resposta4">
          <evaEmotion emotion="HAPPY" key="1073" />
          <audio source="efx-blin2" block="TRUE" key="1074" />
          <light state="ON" color="GREEN" key="1075" />
          <talk key="1076">Você já possui conhecimento para fazer um trem levitar.</talk>
          <evaEmotion emotion="NEUTRAL" key="1077" />
          <light state="OFF" key="1078" />
        </case>
        <default key="1079" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1080" />
          <audio source="efx-error" block="TRUE" key="1081" />
          <light state="ON" color="RED" key="1082" />
          <evaEmotion emotion="NEUTRAL" key="1083" />
          <talk key="1084">Marti méqui flai não poderá se divertir no futuro se você não aprender sobre levitação magnética.</talk>
          <light state="OFF" key="1085" />
        </default>
      </switch>
    </case>
        <case op="eq" value="5" key="1086" child_proc="true" var="$">
          <talk key="1087">o que é? o que é ? Com as pernas bem juntinhas eu giro muito rápido,com uma perna levantada,eu giro bem devagarzinho.</talk>
      <qrRead var="resposta5" key="1088" />
      <switch var="resposta5">
        <case op="exact" value="plataformagiratoria" key="1089" child_proc="true" var="resposta5">
          <evaEmotion emotion="HAPPY" key="1090" />
          <audio source="efx-blin2" block="TRUE" key="1091" />
          <light state="ON" color="GREEN" key="1092" />
          <talk key="1093">Sua pirueta foi fantástica!</talk>
          <evaEmotion emotion="NEUTRAL" key="1094" />
          <light state="OFF" key="1095" />
        </case>
        <default key="1096" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1097" />
          <audio source="efx-error" block="TRUE" key="1098" />
          <light state="ON" color="RED" key="1099" />
          <evaEmotion emotion="NEUTRAL" key="1100" />
          <talk key="1101">Pelo visto, você andou faltando as aulas de balé.</talk>
          <light state="OFF" key="1102" />
        </default>
      </switch>
      </case>
        <case op="eq" value="6" key="1103" child_proc="true" var="$">
          <talk key="1104">o que é?o que é? Meus movimentos parecem uma dança maluca,nunca faço o mesmo passo duas vezes.</talk>
      <qrRead var="resposta6" key="1105" />
      <switch var="resposta6">
        <case op="exact" value="pendulocaotico" key="1106" child_proc="true" var="resposta6">
          <evaEmotion emotion="HAPPY" key="1107" />
          <audio source="efx-blin2" block="TRUE" key="1108" />
          <light state="ON" color="GREEN" key="1109" />
          <talk key="1110">Uau! Você acertou, e conseguiu acompanhar os passos do pêndulo caótico.</talk>
          <evaEmotion emotion="NEUTRAL" key="1111" />
          <light state="OFF" key="1112" />
        </case>
        <default key="1113" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1114" />
          <audio source="efx-error" block="TRUE" key="1115" />
          <light state="ON" color="RED" key="1116" />
          <evaEmotion emotion="NEUTRAL" key="1117" />
          <talk key="1118">Não desista, tente de novo! Grandes cientistas também erraram antes de acertar. </talk>
          <light state="OFF" key="1119" />
        </default>
      </switch>
    </case>
        <case op="eq" value="7" key="1120" child_proc="true" var="$">
          <talk key="1121">O que é? o que é? Com um pequeno empurrão, eu consigo levantar grandes coisas. Quanto mais longa eu for, mais forte fico. quem sou ? </talk>
      <qrRead var="resposta7" key="1122" />
      <switch var="resposta7">
        <case op="exact" value="torque" key="1123" child_proc="true" var="resposta7">
          <evaEmotion emotion="HAPPY" key="1124" />
        <audio source="efx-blin2" block="TRUE" key="1125" />
        <light state="ON" color="GREEN" key="1126" />
        <talk key="1127">seu cérebro esta aplicando torque ou ele sempre é forte assim</talk>
        <evaEmotion emotion="NEUTRAL" key="1128" />
        <light state="OFF" key="1129" />
        </case>
        <default key="1130" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1131" />
        <audio source="efx-error" block="TRUE" key="1132" />
        <light state="ON" color="RED" key="1133" />
          <evaEmotion emotion="NEUTRAL" key="1134" />
        <talk key="1135">Quase lá! A alavanca parece mágica, mas é só física! Com ela, até uma criança pode levantar coisas bem pesadas. Vamos tentar outra vez!</talk>
        <light state="OFF" key="1136" />
        </default>
      </switch>
    </case>
        <case op="eq" value="8" key="1137" child_proc="true" var="$">
          <talk key="1138">O que é? o que é ? com uma só de mim sou fraca, com muitas a união faz a força </talk>
      <qrRead var="resposta8" key="1139" />
      <switch var="resposta8">
        <case op="exact" value="polia" key="1140" child_proc="true" var="resposta8">
          <evaEmotion emotion="HAPPY" key="1141" />
          <audio source="efx-blin2" block="TRUE" key="1142" />
          <light state="ON" color="GREEN" key="1143" />
          <talk key="1144"> Arrasou, agora você sabe como levantar pesos de forma mais fácil</talk>
          <evaEmotion emotion="NEUTRAL" key="1145" />
          <light state="OFF" key="1146" />

        </case>
        <default key="1147" child_proc="true" value="" op="exact">
          <evaEmotion emotion="SAD" key="1148" />
          <audio source="efx-error" block="TRUE" key="1149" />
          <light state="ON" color="RED" key="1150" />
          <evaEmotion emotion="NEUTRAL" key="1151" />
          <talk key="1152">não é a resposta. Precisa de uma forcinha aí?</talk>
          <light state="OFF" key="1153" />
        </default>
      </switch>
    </case>
      <default key="1154" child_proc="false" value="" op="exact" /></switch>
    <counter var="ITERATION_VAR1" op="+" value="1" key="1155" /><goto target="LOOP_ID1_ITERATION_VAR1" /></case><default key="1156" child_proc="false" value="" op="exact" /></switch><talk key="1157">O próximo está pronto?</talk>
    <talk key="1158">apresente o cartão de sim ou de não?</talk>
    <qrRead var="resp" key="1159" />
    <switch var="resp">
      <case op="exact" value="sim" key="1160" child_proc="true" var="resp">
        <goto target="volta" />
      </case>
      <case op="exact" value="não" key="1161" child_proc="true" var="resp">
        <talk key="1162">Tudo bem até a próxima!</talk>
        <stop />
      </case>
    <default key="1163" child_proc="false" value="" op="exact" /></switch>
  </script>
