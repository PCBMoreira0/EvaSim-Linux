<evaml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="pcb" xsi:noNamespaceSchemaLocation="evaml-schema/evaml_schema.xsd" id="f42a83f45934ad4e2e2628bec3dfede9">
  <settings>
    <voice tone="pt-BR_IsabelaV3Voice" key="1000" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
  </settings>
  <script>
    <evaEmotion emotion="NEUTRAL" key="1001" />
    <talk key="1002">Olá,que bom te ver.Eu sou o EVA, um robô interativo. Posso te mostrar algumas das minhas habilidades?</talk>
    <listen key="1003" />
    <switch var="$">
        <case op="contain" value="sim" key="1004" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1005" />
            <talk key="1006">Ótimo!</talk>

        </case>
        <case op="contain" value="não" key="1007" child_proc="true" var="$">
            <talk key="1008">tudo bem até a próxima!</talk>
            <stop />
        </case>

    <default key="1009" child_proc="false" value="" op="exact" /></switch>
    <evaEmotion emotion="NEUTRAL" key="1010" />
    <talk key="1011">Antes de começarmos, posso saber seu nome?</talk>
    <listen var="nome" key="1012" />
    <evaEmotion emotion="HAPPY" key="1013" />
    <motion head="YES" key="1014" />
    <talk key="1015">Muito prazer, #nome!</talk>
    <talk key="1016">Vamos começar!</talk>
    <evaEmotion emotion="NEUTRAL" key="1017" />
    <led animation="SURPRISE" id="volt" key="1018" />
    <talk key="1019">Mostre um cartão com a emoção que você está sentindo agora.</talk>
    <qrRead var="emocao" key="1020" />
    <switch var="emocao">
        <case op="exact" value="feliz" key="1021" child_proc="true" var="emocao">
            <evaEmotion emotion="HAPPY" key="1022" />
            <light state="ON" color="YELLOW" key="1023" />
            <motion head="YES" key="1024" />
            <audio source="song-take-on-me" block="TRUE" key="1025" />
            <talk key="1026">Ah, felicidade detectada! Parece que você acordou com o pé direito hoje, eu fico assim quando encontro Wi-Fi rápido.</talk>
            <led animation="HAPPY" key="1027" />
            <light state="OFF" key="1028" />


        </case>

        <case op="exact" value="triste" key="1029" child_proc="true" var="emocao">
            <light state="ON" color="BLUE" key="1030" />
            <evaEmotion emotion="SAD" key="1031" />
            <audio source="song-sad-violin" block="TRUE" key="1032" />
            <talk key="1033">tristeza detectada. se precisar posso contar uma piada para animar. Quer?</talk>
            <evaEmotion emotion="NEUTRAL" key="1034" />
            <listen key="1035" />
            <switch var="$">
                <case op="contain" value="sim" key="1036" child_proc="true" var="$">
                    <evaEmotion emotion="HAPPY" key="1037" />
                    <talk key="1038">Por que o robô nunca mente? Porque ele sempre tem uma resposta programada!</talk>
                    <evaEmotion emotion="NEUTRAL" key="1039" />
                    <light state="OFF" key="1040" />
                </case>
                <case op="contain" value="não" key="1041" child_proc="true" var="$">
                    <talk key="1042">tudo bem,eu entendo.Quer tentar outra emoção?</talk>
                    <light state="OFF" key="1043" />
                    <listen key="1044" />
                    <switch var="$">
                        <case op="contain" value="sim" key="1045" child_proc="true" var="$">
                            <goto target="volt" />

                        </case>
                        <case op="contain" value="não" key="1046" child_proc="false" var="$">


                        </case>
                    <default key="1047" child_proc="false" value="" op="exact" /></switch>
                </case>
            <default key="1048" child_proc="false" value="" op="exact" /></switch>

        </case>

        <case op="exact" value="raiva" key="1049" child_proc="true" var="emocao">
            <light state="ON" color="RED" key="1050" />
            <evaEmotion emotion="ANGRY" key="1051" />
            <talk key="1052">Raiva detectada! Que tal uma pausa para respirar um pouco? Vou tocar um som de meditação para ajudar</talk>
            <evaEmotion emotion="NEUTRAL" key="1053" />
            <audio source="efx-wand1" block="TRUE" key="1054" />
            <light state="OFF" key="1055" />
        </case>
        
        <case op="exact" value="surpreso" key="1056" child_proc="true" var="emocao">
            <light state="ON" color="PINK" key="1057" />
            <evaEmotion emotion="SURPRISE" key="1058" />
            <audio source="efx-susto" block="TRUE" key="1059" />
            <talk key="1060">Uau! Surpresa detectada! O que será que te deixou assim? Foi minha beleza robótica?</talk>
            <evaEmotion emotion="NEUTRAL" key="1061" />
            <light state="OFF" key="1062" />


        </case>

        <case op="exact" value="medo" key="1063" child_proc="true" var="emocao">
            <evaEmotion emotion="FEAR" key="1064" />
            <talk key="1065">Vejo que você está com medo. Isso é normal, não precisa se preocupar.</talk>
            <light state="ON" color="BLUE" key="1066" />
            <talk key="1067">Vou acender uma luz suave para deixar o ambiente mais confortável.</talk>
            <evaEmotion emotion="NEUTRAL" key="1068" />
            <wait duration="1000" key="1069" />
            <light state="OFF" key="1070" />

        </case>
        <case op="exact" value="nojo" key="1071" child_proc="true" var="emocao">
            <evaEmotion emotion="DISGUST" key="1072" />
            <talk key="1073">Se for cheiro ruim, pode deixar comigo! Ainda bem que eu não tenho nariz, hein?</talk>
             <audio source="efx-annoyed-female" block="TRUE" key="1074" />
             <evaEmotion emotion="NEUTRAL" key="1075" />
        </case>
        <case op="exact" value="apaixonada" key="1076" child_proc="true" var="emocao">
            <evaEmotion emotion="INLOVE" key="1077" />
            <light state="ON" color="RED" key="1078" />
            <audio source="song-careless" block="TRUE" key="1079" />
            <talk key="1080">sentindo amor no ar! que momento especial.</talk>
            <evaEmotion emotion="NEUTRAL" key="1081" />
            <light state="OFF" key="1082" />
        </case>
        <case op="exact" value="neutro" key="1083" child_proc="true" var="emocao">
            <evaEmotion emotion="NEUTRAL" key="1084" />
            <light state="ON" color="WHITE" key="1085" />
            <audio source="efx-tic-toc" block="TRUE" key="1086" />
            <talk key="1087">então esssa é a famosa cara de segunda feira!</talk>
            <light state="OFF" key="1088" />


        </case>
    <default key="1089" child_proc="false" value="" op="exact" /></switch>

    <talk key="1090">falando nisso,eu também consigo detectar expressões faciais</talk>
    <talk key="1091">Faça uma expressão, qualquer uma!</talk>
    <userEmotion var="expressao" key="1092" />
    <switch var="expressao">
        <case op="exact" value="NEUTRAL" key="1093" child_proc="true" var="expressao">
            <talk key="1094">me parece que você está com uma expressão Neutra!</talk>
        </case>
        <case op="exact" value="HAPPY" key="1095" child_proc="true" var="expressao">
            <talk key="1096">me parece que você está com uma expressão de feliz</talk>
        </case>
        <case op="exact" value="SAD" key="1097" child_proc="true" var="expressao">
            <talk key="1098">me parece que você está com uma expressão de triste</talk>
        </case>
        <case op="exact" value="ANGRY" key="1099" child_proc="true" var="expressao">
            <talk key="1100">me parece que você está com uma expressão de raiva</talk>
        </case>
        <case op="exact" value="FEAR" key="1101" child_proc="true" var="expressao">
            <talk key="1102">me parece que você está com uma expressão de medo</talk>
        </case>
        <case op="exact" value="SURPRISE" key="1103" child_proc="true" var="expressao">
            <talk key="1104">me parece que você está com uma expressão de surpresa</talk>
        </case>
        <case op="exact" value="DISGUST" key="1105" child_proc="true" var="expressao">
            <talk key="1106">me parece que você está com uma expressão de nojo</talk>
        </case>
        <case op="exact" value="INLOVE" key="1107" child_proc="true" var="expressao">
            <talk key="1108">me parece que você está com uma expressão de apaixonado</talk>
        </case>
    <default key="1109" child_proc="false" value="" op="exact" /></switch>
    <talk key="1110">acertei?</talk>
    <listen key="1111" />
    <switch var="$">
        <case op="contain" value="sim" key="1112" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1113" />
        </case>
        <case op="contain" value="não" key="1114" child_proc="true" var="$">
            <evaEmotion emotion="SAD" key="1115" />
            <talk key="1116">Vou continuar treinando! Cada rosto é um desafio diferente.</talk>
            <evaEmotion emotion="NEUTRAL" key="1117" />
        </case>
    <default key="1118" child_proc="false" value="" op="exact" /></switch>
    <talk key="1119">Tecnologia também pode ser acolhedora.Pra encerrar, posso tocar um som especial só pra você. Algum estilo preferido?</talk>
    <led animation="HAPPY" id="voltar" key="1120" />
    <talk key="1121">divertido,surpresa ou calmo?</talk>
    <listen key="1122" />
    <switch var="$">
        <case op="contain" value="divertido" key="1123" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1124" />
            <motion head="NO" key="1125" />
            <audio source="song-thriller-open" block="TRUE" key="1126" />
            <led animation="RAINBOW" key="1127" />
            <evaEmotion emotion="NEUTRAL" key="1128" />
            
        </case>
        <case op="contain" value="surpresa" key="1129" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1130" />
            <motion head="NO" key="1131" />
            <audio source="song-samba-loop" block="TRUE" key="1132" />
            <led animation="RAINBOW" key="1133" />
            <evaEmotion emotion="NEUTRAL" key="1134" />
        </case>
        <case op="contain" value="calmo" key="1135" child_proc="true" var="$">
            <evaEmotion emotion="HAPPY" key="1136" />
            <motion head="YES" key="1137" />
            <audio source="song-here-comes-the-sun" block="TRUE" key="1138" />
            <led animation="RAINBOW" key="1139" />
            
        </case>
        <default key="1140" child_proc="true" value="" op="exact">
            <evaEmotion emotion="SAD" key="1141" />
            <talk key="1142">Desculpe não entendi, pode repetir novamente por favor</talk>
            <evaEmotion emotion="NEUTRAL" key="1143" />
            <goto target="voltar" />
        </default>
    </switch>
    <evaEmotion emotion="HAPPY" key="1144" />
    <talk key="1145"> Espero que tenha gostado, #nome! Foi ótimo interagir com você.</talk>
    <talk key="1146">Até a próxima!</talk>
    <audio source="efx-mario-start-01" block="TRUE" key="1147" />
  </script>
